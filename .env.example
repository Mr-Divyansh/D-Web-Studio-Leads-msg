# ------------------------------------------------------------------
# D Web Studio Outreach - LOCAL CONFIGURATION
# Secrets are NEVER stored here. OAuth files live in credentials/.
# ------------------------------------------------------------------
APP_ENV=local

# SAFETY: DRY_RUN=true generates + validates messages but sends NOTHING.
# Live sending requires DRY_RUN=false AND a real connected provider.
DRY_RUN=true

EMAIL_ENABLED=true
WHATSAPP_ENABLED=true
AI_ENABLED=true

MAX_RETRIES=3
EMAIL_DELAY_SECONDS=10
WHATSAPP_DELAY_SECONDS=10

PRIORITY_ONLY=true
FOLLOW_UP_ENABLED=false

# Campaign scope + rate limits
CAMPAIGN_MAX_MESSAGES=200
CAMPAIGN_MESSAGES_PER_MINUTE=6

# Dashboard (local loopback only)
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8756
LOG_LEVEL=INFO

# Local paths
DB_PATH=data/outreach.db
LEAD_IMPORT_PATH=data/import/Lead for web dg.xlsx
GMAIL_CREDENTIALS_PATH=credentials/gmail/credentials.json
GMAIL_TOKEN_PATH=credentials/gmail/token.json

# WhatsApp provider adapter: stub | meta_cloud
# Real credentials go to the OS keyring, never this file.
WHATSAPP_PROVIDER=stub

# AI provider: disabled | openai | anthropic | local
AI_PROVIDER=disabled
AI_MODEL=

# Gmail sender identity (leave blank to use the authorized account)
GMAIL_SENDER_NAME=D Web Studio
GMAIL_SENDER_EMAIL=
# Google OAuth loopback host (must match the registered redirect URI)
OAUTH_REDIRECT_HOST=localhost
